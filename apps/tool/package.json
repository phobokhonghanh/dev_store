{
  "name": "tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --turbopack -p 3003",
    "fmt": "yarn format",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,toml,yaml,yml,css,scss}\" --ignore-path ../../.gitignore .",
    "lint": "eslint . && echo 'Lint Finished'",
    "prettier-check": "prettier --check .",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "prettier": "@origini/prettier",
  "dependencies": {
    "@origini/components": "*",
    "@origini/config": "*",
    "@origini/libs": "*",
    "@radix-ui/react-icons": "^1.3.0",
    "dotenv-cli": "^11.0.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^0.561.0",
    "next": "16.0.10",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "swr": "^2.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@origini/eslint-config-custom": "*",
    "@origini/interfaces": "*",
    "@origini/prettier": "*",
    "@origini/tailwind-config": "*",
    "@origini/tsconfig": "*",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "*",
    "eslint-config-next": "*",
    "eslint-config-prettier": "*",
    "eslint-config-turbo": "*",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.4.18",
    "prettier": "^3.0.0",
    "tailwindcss": "*",
    "tw-animate-css": "*",
    "typescript": "*"
  }
}
