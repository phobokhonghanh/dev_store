{
  "name": "origini",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phobokhonghanh/dev_store.git"
  },
  "scripts": {
    "prepare": "husky",
    "cz": "cz",
    "dev": "dotenv -- turbo dev --parallel",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,toml,yaml,yml,css,scss}\" --ignore-path .gitignore",
    "fmt": "dotenv -- turbo format",
    "lint": "dotenv -- turbo lint",
    "prettier-check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "dotenv -- turbo test",
    "build": "dotenv -- turbo build",
    "start": "dotenv -- turbo start"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@origini/tsconfig": "*",
    "@tailwindcss/postcss": "^4.1.6",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-turbo": "^2.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.6",
    "turbo": "^2.5.3",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "packageManager": "yarn@1.22.22"
}
